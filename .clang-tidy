# --- Enabled / Disabled Checks ---
# A comma-separated string or a YAML list of globs.
# Use '*' to enable everything, and '-' prefixes to disable specific checks.
Checks:
  - "-*"
  - "clang-diagnostic-*"
  - "clang-analyzer-*"
  - "cppcoreguidelines-*"
  - "readability-*"
  - "performance-*"
  - "bugprone-*"
  - "cert-*"
  - "-bugprone-easily-swappable-parameters"
  - "-bugprone-empty-catch"
  - "-bugprone-suspicious-stringview-data-usage"
  - "-bugprone-throwing-static-initialization"
  - "-cppcoreguidelines-pro-type-vararg"
  - "-cppcoreguidelines-avoid-c-arrays"
  - "-cppcoreguidelines-avoid-non-const-global-variables"
  - "-cppcoreguidelines-pro-type-union-access"
  - "-cppcoreguidelines-pro-type-reinterpret-cast"
  - "-cppcoreguidelines-pro-bounds-array-to-pointer-decay"
  - "-cppcoreguidelines-pro-bounds-avoid-unchecked-container-access"
  - "-cppcoreguidelines-macro-usage"
  - "-cppcoreguidelines-pro-type-const-cast"
  - "-cppcoreguidelines-pro-bounds-pointer-arithmetic"
  - "-cppcoreguidelines-missing-std-forward"
  - "-cppcoreguidelines-pro-bounds-constant-array-index"
  - "-cppcoreguidelines-special-member-functions"
  - "-cppcoreguidelines-pro-type-member-init"
  - "-cert-err33-c"
  - "-cert-err58-cpp"
  - "-hicpp-use-auto"
  - "modernize-*"
  - "-modernize-use-trailing-return-type"
  - "-modernize-use-using"
  - "-modernize-use-auto"
  - "-modernize-avoid-c-arrays"
  - "-modernize-concat-nested-namespaces"
  - "-performance-no-int-to-ptr"
  - "-readability-identifier-length"
  - "-bugprone-macro-parentheses"
  - "-readability-trailing-comma"
  - "-readability-uppercase-literal-suffix"

WarningsAsErrors: "bugprone-*,modernize-concat-nested-namespaces"

FormatStyle: "file"

ExtraArgs: ["-std=c++20", "-Wall"]

CheckOptions:
  - key: readability-identifier-naming.VariableCase
    value: "lower_case"
  - key: readability-identifier-naming.ConstexprVariableCase
    value: "UPPER_CASE"
  - key: readability-identifier-naming.ConstexprVariableStyle
    value: ""
  - key: modernize-loop-convert.NamingStyle
    value: "CamelCase"
  - key: cppcoreguidelines-explicit-virtual-functions.IgnoreDestructors
    value: "true"
  - key: cppcoreguidelines-avoid-magic-numbers.IgnoredIntegerValues
    value: "1;2;4;8" # Common alignment and buffer sizes
  - key: cppcoreguidelines-avoid-magic-numbers.IgnoreTypeAliases
    value: "true"
  - key: readability-magic-numbers.IgnorePowersOf2IntegerValues
    value: "true"
  - key: cppcoreguidelines-avoid-magic-numbers.IgnoreBitFieldsWidths
    value: "true"
